# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Anthropic Claude API (REQUIRED for name generation)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# DOMAIN AVAILABILITY CHECKING - Choose one provider
# =============================================================================

# Domain Checker Provider: whoapi | whoisxml | simulation
# If not set, will auto-select based on available API keys
DOMAIN_CHECKER=whoapi

# WhoAPI (RECOMMENDED - 10,000 free requests one-time)
# Sign up at: https://whoapi.com/
# Free tier: 10,000 requests (one-time, non-renewable)
# Paid: ~$0.005 per request after free tier
WHOAPI_KEY=your_whoapi_key_here

# WhoisXML API (100 free requests per month)
# Sign up at: https://whoisxmlapi.com/
# Free tier: 100 requests/month
# Paid: ~$0.01-0.03 per request
# WHOISXML_API_KEY=your_whoisxml_api_key_here

# =============================================================================
# OPTIONAL: Additional Domain Registrar APIs
# =============================================================================

# Gandi API (No free tier - paid only)
# Get your key at: https://admin.gandi.net/
# Requires: Personal Access Token from Gandi admin panel
# GANDI_API_KEY=your_gandi_api_key_here

# Namecheap API (Free with account, requires IP whitelisting)
# Get your key at: https://www.namecheap.com/support/api/
# Requires: Active account with purchases + whitelisted IP
# NAMECHEAP_API_USER=your_namecheap_username
# NAMECHEAP_API_KEY=your_namecheap_api_key
# NAMECHEAP_CLIENT_IP=your_whitelisted_ip_address

# Domainr API via RapidAPI (Free tier available)
# Sign up at: https://rapidapi.com/domainr/api/domainr
# RAPIDAPI_KEY=your_rapidapi_key_here

# =============================================================================
# FUTURE: Trademark & Social Media APIs (Not yet implemented)
# =============================================================================

# INPI (France) - Trademark verification
# https://data.inpi.fr/
# INPI_API_KEY=your_inpi_api_key

# USPTO (USA) - Trademark verification
# https://www.uspto.gov/learning-and-resources/open-data-and-mobility
# USPTO_API_KEY=your_uspto_api_key

# Social Media verification services
# NAMECHK_API_KEY=your_namechk_api_key
